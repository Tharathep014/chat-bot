# Optional. No AI API key required.
PORT=3001
HOST=127.0.0.1

# Optional: read the schedule from Supabase instead of server/data/schedule.json.
# Supabase dashboard -> Project Settings -> API: copy the Project URL and the
# publishable (anon) key. Never put the secret / service_role key here.
# Leave both empty to use the JSON file.
SUPABASE_URL=
SUPABASE_KEY=
# How long (seconds) to reuse loaded data before reading Supabase again.
SCHEDULE_CACHE_SECONDS=60
